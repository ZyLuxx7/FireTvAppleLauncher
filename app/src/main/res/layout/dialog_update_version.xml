<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="26dp">

    <TextView
        android:id="@+id/updateNoticeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/update_notice_title"
        android:textColor="@color/tvos_label_primary"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/updateNoticeVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/tvos_label_secondary"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/updateNoticeNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4sp"
            android:textColor="@color/tvos_label_primary"
            android:textSize="16sp" />
    </ScrollView>

    <TextView
        android:id="@+id/updateNoticeReadTerms"
        style="@style/AlertButton"
        android:layout_marginTop="10dp"
        android:text="@string/update_terms_read" />

    <CheckBox
        android:id="@+id/updateNoticeAccepted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:buttonTint="#FF8FE3D8"
        android:focusable="true"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp"
        android:text="@string/update_terms_checkbox"
        android:textColor="@color/tvos_label_primary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateNoticeExit"
            style="@style/AlertButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/update_terms_decline"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/updateNoticeContinue"
            style="@style/AlertButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/update_terms_accept"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
