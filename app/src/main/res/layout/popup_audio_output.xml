<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/audioOutputPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="@dimen/tvos_panel_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/audioOutputPopupTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:textColor="@color/tvos_label_primary"
            android:textSize="@dimen/tvos_text_headline" />

        <TextView
            android:id="@+id/audioOutputBluetooth"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/input_row_bg"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="90dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:stateListAnimator="@animator/tvos_focus_control"
            android:text="@string/quick_audio_bluetooth"
            android:textColor="@drawable/pill_text"
            android:textSize="@dimen/tvos_text_caption1"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/audioOutputPopupStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@drawable/pill_text_dim"
        android:textSize="@dimen/tvos_text_caption1" />

    <TextView
        android:id="@+id/audioOutputPopupAction"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/audioOutputDeviceScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/audioOutputDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
