<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appsDrawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_backdrop">

    <ImageView
        android:id="@+id/appsDrawerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/appsDrawerBackdropShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/now_playing_backdrop_shade"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/appsDrawerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appsDrawerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="@string/quick_apps"
            android:textColor="@color/tvos_label_primary"
            android:textSize="@dimen/tvos_text_title3" />

        <EditText
            android:id="@+id/allAppsSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="54dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="54dp"
            android:background="@drawable/input_row_bg"
            android:hint="@string/quick_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:nextFocusDown="@id/allAppsGrid"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/tvos_label_primary"
            android:textColorHint="@color/tvos_label_secondary"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/allAppsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="54dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="54dp"
            android:layout_marginBottom="28dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/allAppsEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="54dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="54dp"
            android:layout_marginBottom="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/no_apps_to_manage"
            android:textColor="@color/tvos_label_secondary"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
