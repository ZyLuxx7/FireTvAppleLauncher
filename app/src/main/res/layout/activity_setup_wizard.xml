<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/setupBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/home_wallpaper"
        android:visibility="gone" />

    <View
        android:id="@+id/setupBackgroundShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99080A10"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/setupRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="44dp"
        android:paddingEnd="32dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/setupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/tvos_label_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/setupSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/tvos_label_secondary"
            android:textSize="16sp" />

        <ScrollView
            android:layout_width="460dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/setupOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />
        </ScrollView>

        <TextView
            android:id="@+id/setupProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/tvos_label_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/setupPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/setupActions"
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/setupBack"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/quick_control_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/setup_back"
                android:textColor="@drawable/pill_text"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/setupNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/quick_control_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/setup_next"
                android:textColor="@drawable/pill_text"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/setupBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_brand"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/setupSkip"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/quick_control_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="120dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/setup_skip"
        android:textColor="@drawable/pill_text"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium" />
</FrameLayout>
