<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:orientation="vertical"
    android:padding="26dp">

    <TextView
        android:id="@+id/updateAvailableTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/update_available_title"
        android:textColor="@color/tvos_label_primary"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/updateAvailableVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FF8FE3D8"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/updateAvailableMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4sp"
        android:text="@string/update_available_message"
        android:textColor="@color/tvos_label_secondary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateAvailableLater"
            style="@style/AlertButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/update_available_later"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/updateAvailableNow"
            style="@style/AlertButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/update_available_update"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
