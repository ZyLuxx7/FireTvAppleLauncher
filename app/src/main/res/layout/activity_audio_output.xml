<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_backdrop">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#46000000" />

    <TextView
        android:id="@+id/audioOutputBack"
        style="@style/SettingsRow"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="42dp"
        android:layout_marginTop="30dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/now_playing_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="190dp"
        android:layout_marginEnd="190dp"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_output_title"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/audio_output_description"
            android:textColor="#D9FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/audioOutputFireTv"
            style="@style/SettingsRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/audio_output_fire_tv" />

        <TextView
            android:id="@+id/audioOutputSpotify"
            style="@style/SettingsRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/audio_output_spotify" />
    </LinearLayout>
</FrameLayout>
