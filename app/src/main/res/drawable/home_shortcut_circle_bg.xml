<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#F2FFFFFF" />
            <stroke android:width="1dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" />
            <stroke android:width="1dp" android:color="#BFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#B51E1E1E"
                android:centerColor="#A51D1D20"
                android:endColor="#9413171D" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
