<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#A6424C5A"
                android:centerColor="#A3323B49"
                android:endColor="#A51C2531" />
            <stroke android:width="1.5dp" android:color="#D9FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#91424C5A"
                android:endColor="#991C2531" />
            <stroke android:width="1dp" android:color="#A6FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#B5303743"
                        android:centerColor="#A62C3542"
                        android:endColor="#99232A34" />
                    <stroke android:width="1dp" android:color="#80FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#20FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
